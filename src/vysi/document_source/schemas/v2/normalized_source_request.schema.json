{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vysi.dev/document-source/v2/normalized_source_request.schema.json",
  "title": "NormalizedSourceRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "request_id",
    "request_hash",
    "source_request_ref",
    "normalized_sources",
    "effective_policy_ref"
  ],
  "properties": {
    "header": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/header"
    },
    "request_id": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
    },
    "request_hash": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
    },
    "source_request_ref": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/reference"
    },
    "normalization_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_policy_ref": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/reference"
    },
    "normalized_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sourceLocator"
      }
    }
  }
}

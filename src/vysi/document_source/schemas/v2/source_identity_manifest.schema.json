{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vysi.dev/document-source/v2/source_identity_manifest.schema.json",
  "title": "SourceIdentityManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "bundle_ref",
    "logical_documents"
  ],
  "properties": {
    "header": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/header"
    },
    "bundle_ref": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/reference"
    },
    "logical_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "artifact_ids",
          "content_identity_hash"
        ],
        "properties": {
          "document_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "artifact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
            }
          },
          "content_identity_hash": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
          },
          "selection_hash": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
          },
          "parent_document_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "embedding_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

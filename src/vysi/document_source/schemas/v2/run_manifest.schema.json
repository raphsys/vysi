{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vysi.dev/document-source/v2/run_manifest.schema.json",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "run_id",
    "request_ref",
    "nodes",
    "started_at"
  ],
  "properties": {
    "header": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/header"
    },
    "run_id": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
    },
    "request_ref": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/reference"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "stage",
          "state",
          "attempts"
        ],
        "properties": {
          "node_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "stage": {
            "type": "string",
            "pattern": "^DS(?:0[0-9]|1[0-5])$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "running",
              "succeeded",
              "partial",
              "failed",
              "blocked",
              "cancelled",
              "invalidated",
              "superseded"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "input_hashes": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
            }
          },
          "output_refs": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/reference"
            }
          }
        }
      }
    },
    "cancellation_requested": {
      "type": "boolean"
    },
    "resume_from_run_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

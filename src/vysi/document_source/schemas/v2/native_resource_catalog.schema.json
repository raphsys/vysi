{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vysi.dev/document-source/v2/native_resource_catalog.schema.json",
  "title": "NativeResourceCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "document_id",
    "resources",
    "occurrences"
  ],
  "properties": {
    "header": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/header"
    },
    "document_id": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "kind",
          "owner_id",
          "source_address",
          "active",
          "opaque"
        ],
        "properties": {
          "resource_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "kind": {
            "type": "string"
          },
          "owner_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "source_address": {
            "type": "string"
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "anyOf": [
              {
                "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "stored_ref": {
            "anyOf": [
              {
                "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/reference"
              },
              {
                "type": "null"
              }
            ]
          },
          "active": {
            "type": "boolean"
          },
          "opaque": {
            "type": "boolean"
          }
        }
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrence_id",
          "resource_id",
          "owner_id",
          "source_address"
        ],
        "properties": {
          "occurrence_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "resource_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "owner_id": {
            "type": "string"
          },
          "source_address": {
            "type": "string"
          },
          "geometry_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

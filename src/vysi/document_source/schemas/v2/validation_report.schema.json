{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vysi.dev/document-source/v2/validation_report.schema.json",
  "title": "ValidationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "run_id",
    "policy_ref",
    "validated_snapshot",
    "package_status",
    "commit_eligible",
    "summary",
    "checks",
    "document_results",
    "error_refs"
  ],
  "properties": {
    "header": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/header"
    },
    "run_id": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
    },
    "policy_ref": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/reference"
    },
    "validated_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_sha256",
        "artifact_set_sha256",
        "artifact_count",
        "contract_count",
        "reference_count"
      ],
      "properties": {
        "checkpoint_sha256": {
          "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
        },
        "artifact_set_sha256": {
          "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "contract_count": {
          "type": "integer",
          "minimum": 0
        },
        "reference_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "package_status": {
      "type": "string",
      "enum": [
        "ok",
        "review",
        "rejected",
        "error",
        "cancelled"
      ]
    },
    "commit_eligible": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks_total",
        "checks_passed",
        "checks_warning",
        "checks_failed",
        "checks_not_applicable",
        "blocking_failures",
        "documents_total",
        "documents_ok",
        "documents_review",
        "documents_rejected",
        "documents_error",
        "documents_cancelled",
        "catalogued_errors"
      ],
      "properties": {
        "checks_total": {
          "type": "integer",
          "minimum": 1
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warning": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_failures": {
          "type": "integer",
          "minimum": 0
        },
        "documents_total": {
          "type": "integer",
          "minimum": 0
        },
        "documents_ok": {
          "type": "integer",
          "minimum": 0
        },
        "documents_review": {
          "type": "integer",
          "minimum": 0
        },
        "documents_rejected": {
          "type": "integer",
          "minimum": 0
        },
        "documents_error": {
          "type": "integer",
          "minimum": 0
        },
        "documents_cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "catalogued_errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "code",
          "kind",
          "scope",
          "status",
          "severity",
          "blocking",
          "message",
          "evidence_refs"
        ],
        "properties": {
          "check_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "code": {
            "type": "string",
            "pattern": "^DS-VAL-[0-9]{3}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "schema",
              "hash",
              "reference",
              "invariant",
              "security",
              "format",
              "policy",
              "storage",
              "identity",
              "completeness",
              "execution",
              "determinism"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warning",
              "fail",
              "not_applicable"
            ]
          },
          "severity": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/severity"
          },
          "blocking": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "fail"
                }
              }
            },
            "then": {
              "properties": {
                "severity": {
                  "enum": [
                    "error",
                    "critical"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "blocking": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": "fail"
                }
              }
            }
          }
        ]
      }
    },
    "document_results": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "status",
          "commit_eligible",
          "check_refs",
          "evidence_refs",
          "error_refs"
        ],
        "properties": {
          "document_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "review",
              "rejected",
              "error",
              "cancelled"
            ]
          },
          "commit_eligible": {
            "type": "boolean"
          },
          "check_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "error_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "rejected",
                    "error",
                    "cancelled"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "commit_eligible": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "error_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "package_status": {
            "enum": [
              "rejected",
              "error",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "commit_eligible": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "commit_eligible": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "package_status": {
            "enum": [
              "ok",
              "review"
            ]
          },
          "summary": {
            "properties": {
              "blocking_failures": {
                "const": 0
              },
              "documents_total": {
                "minimum": 1
              }
            }
          },
          "document_results": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

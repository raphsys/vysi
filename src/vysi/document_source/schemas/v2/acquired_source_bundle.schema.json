{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vysi.dev/document-source/v2/acquired_source_bundle.schema.json",
  "title": "AcquiredSourceBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "bundle_id",
    "artifacts"
  ],
  "properties": {
    "header": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/header"
    },
    "bundle_id": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "source_locator_id",
          "role",
          "ordinal",
          "original_name",
          "stored_path",
          "size_bytes",
          "sha256",
          "acquisition_kind"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "role": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "original_name": {
            "type": "string"
          },
          "stored_path": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/portablePath"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/sha256"
          },
          "acquisition_kind": {
            "type": "string"
          },
          "source_uri_redacted": {
            "type": [
              "string",
              "null"
            ]
          },
          "declared_media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_locator_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          }
        }
      }
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}

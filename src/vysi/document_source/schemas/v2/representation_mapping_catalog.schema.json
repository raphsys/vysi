{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vysi.dev/document-source/v2/representation_mapping_catalog.schema.json",
  "title": "RepresentationMappingCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "header",
    "document_id",
    "mappings"
  ],
  "properties": {
    "header": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/header"
    },
    "document_id": {
      "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mapping_id",
          "source_layer",
          "source_ids",
          "target_layer",
          "target_ids",
          "relation",
          "exactness",
          "confidence",
          "method",
          "evidence_refs",
          "cardinality",
          "producer",
          "producer_version",
          "determinism"
        ],
        "properties": {
          "mapping_id": {
            "$ref": "https://schemas.vysi.dev/document-source/v2/common.schema.json#/$defs/id"
          },
          "source_layer": {
            "type": "string",
            "enum": [
              "binary",
              "container",
              "native",
              "technical_ir",
              "rendered",
              "geometry",
              "asset"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "target_layer": {
            "type": "string",
            "enum": [
              "container",
              "native",
              "technical_ir",
              "rendered",
              "geometry",
              "asset"
            ]
          },
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "exactness": {
            "type": "string",
            "enum": [
              "exact",
              "approximate",
              "inferred"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "one_to_one",
              "one_to_many",
              "many_to_one",
              "many_to_many"
            ]
          },
          "producer": {
            "type": "string",
            "minLength": 3
          },
          "producer_version": {
            "type": "string",
            "minLength": 1
          },
          "determinism": {
            "type": "string",
            "enum": [
              "deterministic",
              "nondeterministic"
            ]
          }
        }
      }
    }
  }
}

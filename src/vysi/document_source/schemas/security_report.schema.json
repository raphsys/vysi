{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://raphsys.local/schemas/document_source/security_report.schema.json",
  "title": "security_report",
  "required": [
    "header",
    "findings",
    "external_access_performed",
    "active_content_executed",
    "final_status"
  ],
  "properties": {
    "header": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "contract_id",
        "created_at",
        "producer"
      ]
    },
    "findings": {
      "type": "array"
    },
    "external_access_performed": {
      "const": false
    },
    "active_content_executed": {
      "const": false
    },
    "final_status": {
      "type": "string"
    }
  }
}

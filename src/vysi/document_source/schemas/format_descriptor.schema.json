{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://raphsys.local/schemas/document_source/format_descriptor.schema.json",
  "title": "format_descriptor",
  "required": [
    "header",
    "format_name",
    "family",
    "layout_nature",
    "container_kind",
    "confidence"
  ],
  "properties": {
    "header": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "contract_id",
        "created_at",
        "producer"
      ]
    },
    "format_name": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "layout_nature": {
      "type": "string"
    },
    "container_kind": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}

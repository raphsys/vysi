{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$id": "https://raphsys.local/schemas/document_source/feature_coverage_report.schema.json",
  "title": "feature_coverage_report",
  "required": [
    "header",
    "items",
    "coverage_ratio"
  ],
  "properties": {
    "header": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "contract_id",
        "created_at",
        "producer"
      ]
    },
    "items": {
      "type": "array"
    },
    "coverage_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
